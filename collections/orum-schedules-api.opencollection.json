        {
          "info": {
            "name": "Get schedule by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.orum.io/deliver/schedules/:id",
            "headers": [
              {
                "name": "Orum-Version",
                "value": ""
